const $=s=>document.querySelector(s);$('#theme').onclick=()=>document.documentElement.dataset.theme=document.documentElement.dataset.theme==='dark'?'light':'dark';$('#print').onclick=()=>print();document.querySelectorAll('[data-layer]').forEach(x=>x.onchange=()=>document.querySelector(`[data-group="${x.dataset.layer}"]`).classList.toggle('off',!x.checked));fetch('assets/data/questions.json').then(x=>x.json()).then(a=>{let q=a[0];$('#question').textContent=q.question;let box=$('#options');q.options.forEach((x,i)=>{let b=document.createElement('button');b.textContent=x;b.onclick=()=>{$('#answer').hidden=false;$('#answer').textContent=q.explanation};box.append(b)})});if('serviceWorker'in navigator)navigator.serviceWorker.register('service-worker.js');